# 网页访问的域名，也用于生成邮箱地址
APP_DOMAIN=mail.example.com
PUBLIC_URL=https://mail.example.com
APP_PORT=3002

# demo: 本地演示，只能在本站生成的邮箱之间收发
# mailgun: Mailgun 收信（webhook）+ Mailgun 发信
# smtp: 自定义 SMTP 发信，收信仍走 Mailgun webhook
MAIL_PROVIDER=demo

# Mailgun 配置
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=

# 自定义 SMTP 发信配置（MAIL_PROVIDER=smtp 时使用）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=

# 邮箱有效期（天）
MAILBOX_TTL_DAYS=7
